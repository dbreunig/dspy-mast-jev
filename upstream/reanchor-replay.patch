+@contextmanager
+def replay_answers():
+    """Reuse raw answers to repeated decision requests in this execution context and its DSPy workers.
+
+    A request repeats when the client, signature, question settings, demos, inputs, and LM
+    arguments all match an earlier call. Its stored answers are decoded again under the current
+    thresholds, cuts, and weights, which change how answers are read but not what is asked.
+    Only clients that cache take part, since an uncached client would answer a repeat afresh.
+    Replayed calls skip the client, so they add no history or usage.
+    """
+    with settings.context(_decision_replay=({}, threading.Lock())):
+        yield
+
+
+def _frozen(value):
+    """A hashable form of a request part, or raise TypeError when there is none."""
+    if isinstance(value, dict):
+        return tuple(sorted((k, _frozen(v)) for k, v in value.items()))
+    if isinstance(value, (list, tuple)):
+        return tuple(_frozen(v) for v in value)
+    if isinstance(value, BaseModel):
+        return (type(value), _frozen(value.model_dump()))
+    if hasattr(value, "toDict"):  # dspy.Example
+        return (type(value), _frozen(value.toDict()))
+    hash(value)
+    return value
+
+
 @lru_cache(maxsize=256)
 def evidence_type(kind):
     """Closed schemas work with JSON structured outputs as well as chat adapters."""
